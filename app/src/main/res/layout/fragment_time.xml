<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:padding="24dp">

    <TextView
        android:id="@+id/session_type_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Focus Time"
        android:textColor="?colorPrimary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/time_text"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25:00"
        android:textColor="?colorPrimary"
        android:textSize="64sp"
        android:fontFamily="monospace"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/session_type_text"
        app:layout_constraintBottom_toTopOf="@id/session_text" />

    <TextView
        android:id="@+id/session_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Session 1 of 4"
        android:textColor="?colorSecondary"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/time_text"
        app:layout_constraintBottom_toTopOf="@id/start_button" />

    <Button
        android:id="@+id/start_button"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:text="Start"
        android:textColor="?colorOnPrimary"
        android:backgroundTint="?colorPrimary"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/session_text"
        app:layout_constraintBottom_toTopOf="@id/reset_button" />

    <Button
        android:id="@+id/reset_button"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:text="Reset"
        android:textColor="?colorPrimary"
        android:backgroundTint="@android:color/transparent"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/start_button"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>